{
  "manifest_version": 3,
  "name": "fb-bridge-web",
  "version": "1",
  "description": "Chuyển tin Fanpage từ Hộp thư Business Suite sang fb-bridge-web (omnichannel).",
  "host_permissions": [
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "https://*.facebook.com/*",
    "http://host.docker.internal/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*"
      ],
      "js": [
        "quiet.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*"
      ],
      "js": [
        "bs-inbox-listener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "page_media",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
